# Copy to server/.env and fill in. Never commit server/.env.
PORT=3001
# Person A (laptop only): RP_ID=localhost, ORIGIN=http://localhost:5173
# Person B (iPhone via Tailscale): RP_ID=<laptop>.<tailnet>.ts.net, ORIGIN=https://<laptop>.<tailnet>.ts.net
RP_ID=localhost
ORIGIN=http://localhost:5173
DETECTION_API_KEY=
# Optional: story year shown in Q-Day mode (UI only, never used in verification)
Q_DAY_HEADLINE_YEAR=2035
